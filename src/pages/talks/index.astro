---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import TalkList from '../../components/TalkList.astro';
import { getTalks } from '../../lib/content';

const talks = await getTalks();
---

<Base title="Talks" description="Talks by Xingyu Zhu.">
  <PageHeader kicker={`${talks.length} talks`} title="Talks" />
  <div class="wrap body">
    <TalkList items={talks} />
  </div>
</Base>

<style>
  .body {
    max-width: calc(48rem + 2 * var(--gutter));
    margin-left: max(0px, calc((100vw - var(--wide)) / 2));
    padding-bottom: 4rem;
  }
</style>
