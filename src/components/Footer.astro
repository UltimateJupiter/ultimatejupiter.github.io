---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
const built = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<footer class="footer">
  <div class="wrap inner small">
    <span>© {year} {profile.name}</span>
    <span class="muted">Last updated {built}</span>
    <a href="#main" class="top">Back to top</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    margin-top: 3rem;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: center;
    padding-block: 1.25rem 2.5rem;
    color: var(--ink-2);
    position: relative;
  }
  /* the rule spans the text width, not the gutters */
  .inner::before {
    content: '';
    position: absolute;
    inset: 0 var(--gutter) auto;
    height: 1px;
    background: var(--ink);
  }
  .top {
    margin-left: auto;
    text-decoration: none;
    color: var(--accent);
    font-weight: 500;
  }
</style>
