---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import NewsList from '../components/NewsList.astro';
import FeaturedPubs from '../components/FeaturedPubs.astro';
import PubList from '../components/PubList.astro';
import TalkList from '../components/TalkList.astro';
import PostList from '../components/PostList.astro';
import { profile, homeLimits } from '../data/profile';
import { getNews, getPosts, getPublications, getTalks } from '../lib/content';

const pubs = await getPublications();
const featured = pubs.filter((p) => p.data.featured);
const news = await getNews();
const talks = await getTalks();
const posts = await getPosts();

// Section numbers are assigned in order, so optional sections (Writing) don't leave gaps.
let n = 0;
const next = () => String(++n).padStart(2, '0');
---

<Base>
  <Hero />

  <div class="wrap">
    <section class="section reveal" aria-labelledby="about">
      <SectionHead index={next()} title="Research" shape="circle" id="about" />
      <div class="section-body">
        <p class="lede">{profile.research}</p>
        <div class="facts">
          <div>
            <h3 class="label">Interests</h3>
            <ul>{profile.interests.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div>
            <h3 class="label">Education</h3>
            <ul>
              {
                profile.education.map((e) => (
                  <li>
                    {e.degree}
                    <span class="edu-meta">
                      {e.institution} <span class="mono">· {e.years}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section reveal" aria-labelledby="news">
      <SectionHead index={next()} title="News" shape="diamond" id="news" />
      <div class="section-body">
        <NewsList items={news.slice(0, homeLimits.news)} />
        {news.length > homeLimits.news && <a class="section-more" href="/news/">All news <span>→</span></a>}
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="section reveal" aria-labelledby="writing">
          <SectionHead index={next()} title="Writing" shape="pentagon" id="writing" />
          <div class="section-body">
            <PostList posts={posts.slice(0, homeLimits.posts)} />
            <a class="section-more" href="/blog/">
              All posts <span>→</span>
            </a>
          </div>
        </section>
      )
    }

    <section class="section reveal" aria-labelledby="selected">
      <SectionHead index={next()} title="Selected work" shape="triangle" id="selected" />
      <div class="section-body wide">
        <FeaturedPubs pubs={featured} />
      </div>
    </section>

    <section class="section reveal" aria-labelledby="papers">
      <SectionHead index={next()} title="Publications" shape="square" id="papers" />
      <div class="section-body">
        <PubList pubs={pubs.slice(0, homeLimits.publications)} />
        <a class="section-more" href="/publications/">
          {pubs.length > homeLimits.publications ? 'Full list' : 'Publications page'} <span>→</span>
        </a>
      </div>
    </section>

    <section class="section reveal" aria-labelledby="talks">
      <SectionHead index={next()} title="Talks" shape="hexagon" id="talks" />
      <div class="section-body">
        <TalkList items={talks.slice(0, homeLimits.talks)} />
        {talks.length > homeLimits.talks && <a class="section-more" href="/talks/">All talks <span>→</span></a>}
      </div>
    </section>
  </div>
</Base>

<style>
  .lede {
    font-size: 1.28em;
    line-height: 1.5;
    letter-spacing: -0.005em;
    margin-bottom: 2.25rem;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2rem;
  }
  .facts h3 {
    margin-bottom: 0.6rem;
  }
  .facts ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95em;
  }
  .facts :global(li) {
    padding: 0.2rem 0;
  }
  .facts :global(.mono) {
    font-size: 0.72rem;
  }
  .facts :global(.edu-meta) {
    display: block;
    color: var(--muted);
    font-size: 0.92em;
  }
  .facts :global(li + li) {
    margin-top: 0.35rem;
  }
  .section-body.wide {
    max-width: none;
  }
  @media (max-width: 620px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
