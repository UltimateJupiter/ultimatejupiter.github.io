---
import PubItem from './PubItem.astro';
import { groupByYear, hasEqualContribution, type Publication } from '../lib/content';

interface Props {
  pubs: Publication[];
  /** Draw each paper as a card with its illustration (the publications page). */
  cards?: boolean;
}
const { pubs, cards = false } = Astro.props;
const groups = groupByYear(pubs);
const anyEqual = pubs.some((p) => hasEqualContribution(p.data.authors));
---

<div class:list={['pub-list', { cards }]}>
  {
    groups.map(([year, items]) => (
      <section class="year-group">
        <h3 class="year">{year}</h3>
        <div class="items">
          {items.map((p) => (
            <PubItem pub={p} headingLevel="h4" card={cards} />
          ))}
        </div>
      </section>
    ))
  }
  {anyEqual && <p class="footnote small muted">* Equal contribution</p>}
</div>

<style>
  /* card form: the cards carry their own borders, so the groups are set apart by space alone */
  .cards .year-group + .year-group {
    margin-top: 1.75rem;
  }
  .cards .year-group + .year-group .items {
    border-top: 0;
  }
  .cards .year,
  .cards .year-group:first-child .year {
    padding-top: 0.2rem;
  }
  .year-group {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1.25rem;
  }
  .year {
    font-size: var(--small);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
    color: var(--muted);
    padding-top: 1.6rem;
  }
  .year-group:first-child .year {
    padding-top: 0.28rem;
  }
  .year-group:first-child .items > :global(:first-child) {
    padding-top: 0;
  }
  .year-group + .year-group .items {
    border-top: 1px solid var(--rule);
  }
  .footnote {
    margin: 1.25rem 0 0;
  }
  @media (max-width: 520px) {
    .year-group {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .year,
    .year-group:first-child .year {
      padding-top: 1.25rem;
    }
    .year-group:first-child .year {
      padding-top: 0;
    }
    .year-group .items > :global(:first-child) {
      padding-top: 0.5rem;
    }
    .year-group + .year-group .items {
      border-top: 0;
    }
    .year-group + .year-group {
      border-top: 1px solid var(--rule);
    }
  }
</style>
