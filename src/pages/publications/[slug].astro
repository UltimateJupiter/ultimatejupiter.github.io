---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { authorsHtml, fmtMonth, getBibtex, getPublications, hasEqualContribution, mathHtml, type Publication } from '../../lib/content';

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs.map((pub) => ({ params: { slug: pub.id }, props: { pub } }));
}

const { pub } = Astro.props as { pub: Publication };
const { title, authors, venue, award, date, image, caption, links, abstract } = pub.data;
const bib = getBibtex(pub.id);
---

<Base title={title} description={abstract.slice(0, 180)}>
  <article class="wrap paper">
    <a class="back mono" href="/publications/">← Publications</a>
    <p class="label meta">
      {venue}{award && <span class="award"> · {award}</span>} · {fmtMonth(date)}
    </p>
    <h1>{title}</h1>
    <p class="authors" set:html={authorsHtml(authors)} />
    {hasEqualContribution(authors) && <p class="mono muted eq">* Equal contribution</p>}
    <div class="chips">
      {links.map((l) => <a href={l.url}>{l.name}</a>)}
    </div>

    {
      image && (
        <figure>
          <div class="frame">
            <Image src={image} alt={caption ?? title} widths={[600, 1000, 1600]} sizes="(max-width: 900px) 92vw, 860px" />
          </div>
          {caption && (
            <figcaption class="mono">
              <span class="fig">Figure.</span> {caption}
            </figcaption>
          )}
        </figure>
      )
    }

    {
      abstract && (
        <section>
          <h2 class="label">Abstract</h2>
          <p class="abstract" set:html={mathHtml(abstract)} />
        </section>
      )
    }

    {
      bib && (
        <section>
          <h2 class="label">Citation</h2>
          <div class="bibwrap">
            <pre><code>{bib}</code></pre>
            <button type="button" class="copy mono" data-copy>Copy</button>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .paper {
    max-width: calc(54rem + 2 * var(--gutter));
    padding-top: clamp(6.5rem, 12vw, 9rem);
    padding-bottom: 4rem;
  }
  .back {
    font-size: 0.75rem;
    text-decoration: none;
    color: var(--muted);
  }
  .meta {
    margin-top: 2.5rem;
  }
  .award {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 380;
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 0.75rem 0 1.25rem;
  }
  .authors {
    font-size: 1.1em;
    color: var(--ink-2);
    margin: 0;
  }
  .authors :global(.me) {
    color: var(--ink);
    font-weight: 600;
  }
  .authors :global(.eq) {
    color: var(--muted);
    font-size: 0.7em;
  }
  .eq {
    margin: 0.25rem 0 0;
  }
  .chips {
    margin-top: 1.1rem;
    font-size: 0.8rem;
  }
  figure {
    margin: 3rem 0 0;
  }
  .frame {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: clamp(0.75rem, 3vw, 2rem);
  }
  :global([data-theme='dark']) .frame {
    background: #ecebe6;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .frame {
      background: #ecebe6;
    }
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.7rem;
    color: var(--muted);
    max-width: 40rem;
  }
  .fig {
    color: var(--ink);
  }
  section {
    margin-top: 3rem;
    max-width: 42rem;
  }
  section h2 {
    margin-bottom: 0.9rem;
  }
  .abstract {
    color: var(--ink-2);
    hyphens: auto;
  }
  .bibwrap {
    position: relative;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 1rem 1.2rem;
  }
  pre {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.6;
    overflow-x: auto;
  }
  .copy {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    background: var(--bg);
    border: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.66rem;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(btn.parentElement?.querySelector('code')?.textContent ?? '');
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Select & copy';
    }
    setTimeout(() => (btn.textContent = 'Copy'), 1600);
  });
</script>
