---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import PlatePlot from './PlatePlot.astro';
import { authorsHtml, getBibtex, mathHtml, type Publication } from '../lib/content';
import { plateForPaper } from '../scripts/plates/meta';

interface Props {
  pub: Publication;
  headingLevel?: 'h2' | 'h3' | 'h4';
  /** Draw the paper as a card headed by a strip of its illustration (the publications page). */
  card?: boolean;
}
const { pub, headingLevel: H = 'h3', card = false } = Astro.props;
const { title, authors, venue, award, links, abstract, image, caption } = pub.data;
const bib = getBibtex(pub.id);
const uid = `p-${pub.id}`;
const url = `/publications/${pub.id}/`;
const plate = card ? plateForPaper(pub.id) : undefined;
---

<article class:list={['pub', { 'has-figure': !!image, card }]} data-plates={plate ? '' : undefined} data-plate={plate?.id}>
  {plate && <PlatePlot />}
  <div class="text">
    <H class="pub-title"><a class="plain" href={url}><span>{title}</span></a></H>
    <p class="authors" set:html={authorsHtml(authors)} />
    <p class="venue">
      <span>{venue}</span>
      {award && <span class="marked">{award}</span>}
    </p>
    <div class="chips">
      {links.map((l) => <a href={l.url}>{l.name}</a>)}
      {abstract && <button type="button" aria-expanded="false" aria-controls={`${uid}-abs`} data-toggle>Abstract</button>}
      {bib && <button type="button" aria-expanded="false" aria-controls={`${uid}-bib`} data-toggle>BibTeX</button>}
    </div>
  </div>
  {
    image && !card && (
      <a class="thumb plain figure-frame" href={url} title={caption} tabindex="-1" aria-hidden="true">
        <Image src={image} alt="" widths={[320, 520, 760]} sizes="(max-width: 700px) 92vw, 260px" />
      </a>
    )
  }
  {
    abstract && (
      <div class="panel" id={`${uid}-abs`} hidden>
        <p set:html={mathHtml(abstract)} />
      </div>
    )
  }
  {
    bib && (
      <div class="panel" id={`${uid}-bib`} hidden>
        <pre class="bib"><code>{bib}</code></pre>
        <button type="button" class="copy" data-copy>Copy</button>
      </div>
    )
  }
</article>

<style>
  /* Text on the left; papers with a figure show it on the right. Opened panels span both. */
  .pub {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 2.25rem;
    padding-block: 1.35rem;
  }
  /* not `.pub + .pub`: the component's script tags are emitted after its first instance, so the
     second paper is not an adjacent sibling of the first */
  .pub:not(:first-of-type) {
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 701px) {
    .pub {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }
    .thumb {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
    }
    .panel {
      grid-column: 1 / -1;
    }
  }
  .text {
    max-width: 40rem;
  }

  /* Card form: a box with the text on the left and the paper's illustration filling a panel on
     the right. An opened abstract or BibTeX spans the full width underneath. */
  .pub.card {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    padding: 0;
    background: var(--bg-raised);
    border: 1px solid var(--ink);
    box-shadow: 8px 8px 0 color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .pub.card:not(:first-of-type) {
    border-top: 1px solid var(--ink);
    margin-top: 1.75rem;
  }
  .pub.card :global(.plate-plot) {
    --pt: 18px;
    --pb: 14px;
    height: 9rem;
    border-bottom: 1px solid var(--ink);
    overflow: hidden;
  }
  .pub.card .text {
    max-width: none;
    padding: 1.6rem 1.9rem 1.7rem;
  }
  .pub.card .pub-title {
    font-size: 1.3rem;
    line-height: 1.22;
  }
  .pub.card .authors {
    margin-top: 0.6rem;
  }
  .pub.card .chips {
    margin-top: 0.9rem;
  }
  .pub.card .panel {
    margin: 0 1.9rem 1.7rem;
  }
  @media (min-width: 761px) {
    .pub.card {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 38%);
    }
    .pub.card :global(.plate-plot) {
      grid-column: 2;
      grid-row: 1;
      height: auto;
      min-height: 12.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--ink);
    }
    .pub.card .text {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }
    .pub.card .panel {
      grid-column: 1 / -1;
    }
  }
  .pub-title {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .pub-title a {
    text-decoration: none;
  }
  .pub-title span {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .pub-title a:hover span,
  .pub:has(.thumb:hover) .pub-title span {
    background: var(--mark);
    color: var(--on-mark);
  }
  .authors {
    margin: 0.4rem 0 0;
    color: var(--ink-2);
    font-size: 0.95em;
    line-height: 1.45;
  }
  .authors :global(.me) {
    color: var(--ink);
    font-weight: 700;
  }
  .authors :global(.eq) {
    color: var(--muted);
    font-size: 0.7em;
    margin-left: 0.05em;
  }
  .venue {
    margin: 0.2rem 0 0;
    font-style: italic;
    color: var(--muted);
    font-size: 0.95em;
  }
  .venue .marked {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    transition: border-color 0.2s;
  }
  .thumb:hover {
    border-color: var(--ink);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.5rem;
  }
  @media (max-width: 700px) {
    .thumb {
      margin-top: 1rem;
      max-width: 26rem;
    }
  }

  .panel {
    position: relative;
    margin-top: 1rem;
    padding: 1rem 1.2rem;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: 0.93em;
    color: var(--ink-2);
  }
  .panel p {
    margin: 0;
    max-width: 44rem;
  }
  .bib {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { mountPlates } from '../scripts/plates';
  document.querySelectorAll<HTMLElement>('.pub.card[data-plates]').forEach(mountPlates);
</script>

<script>
  document.addEventListener('click', async (e) => {
    const el = e.target as HTMLElement;
    const toggle = el.closest<HTMLButtonElement>('[data-toggle]');
    if (toggle) {
      const panel = document.getElementById(toggle.getAttribute('aria-controls')!);
      if (!panel) return;
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      // one panel per paper at a time
      toggle.parentElement?.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        document.getElementById(b.getAttribute('aria-controls')!)?.setAttribute('hidden', '');
      });
      if (open) {
        toggle.setAttribute('aria-expanded', 'true');
        panel.removeAttribute('hidden');
      }
      return;
    }
    const copy = el.closest<HTMLButtonElement>('[data-copy]');
    if (copy) {
      const text = copy.parentElement?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        copy.textContent = 'Copied';
      } catch {
        copy.textContent = 'Select and copy';
      }
      setTimeout(() => (copy.textContent = 'Copy'), 1600);
    }
  });
</script>
