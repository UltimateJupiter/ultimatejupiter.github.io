---
import { fmtDay, groupByYear, isoDate, postUrl, readingTime, type Post } from '../lib/content';

interface Props {
  posts: Post[];
  /** Group under year headings (the full blog index) or a flat list (home page). */
  grouped?: boolean;
}
const { posts, grouped = false } = Astro.props;
const groups = grouped ? groupByYear(posts) : [[null, posts] as const];
---

<div class="posts">
  {
    groups.map(([year, items]) => (
      <section class:list={['group', { grouped }]}>
        {year && <h2 class="year">{year}</h2>}
        <ul>
          {items.map((p) => (
            <li>
              <a class="post plain" href={postUrl(p)}>
                <span class="title"><span>{p.data.title}</span></span>
                <span class="desc">{p.data.description}</span>
                <span class="meta small">
                  <time datetime={isoDate(p.data.date)}>{fmtDay(p.data.date)}</time>
                  <span>{p.data.href ? 'Interactive figures' : `${readingTime(p.body)} min read`}</span>
                  {p.data.draft && <span class="marked">Draft</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .posts {
    max-width: 46rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .group.grouped {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1.25rem;
  }
  .group.grouped + .group.grouped ul {
    border-top: 1px solid var(--rule);
  }
  .year {
    font-size: var(--small);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
    color: var(--muted);
    padding-top: 1.55rem;
  }
  .group.grouped:first-child .year {
    padding-top: 0.28rem;
  }
  li + li {
    border-top: 1px solid var(--rule);
  }
  .post {
    display: block;
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
  }
  li:first-child .post {
    padding-top: 0;
  }
  .title {
    display: block;
    font-family: var(--sans);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .title span {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .post:hover .title span {
    background: var(--mark);
    color: var(--on-mark);
  }
  .desc {
    display: block;
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: 0.95em;
    line-height: 1.5;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    margin-top: 0.5rem;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .group.grouped {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .year,
    .group.grouped:first-child .year {
      padding-top: 0;
    }
    .group.grouped + .group.grouped {
      margin-top: 1.5rem;
    }
  }
</style>
