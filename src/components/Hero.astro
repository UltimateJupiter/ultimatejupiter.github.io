---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import PlatePlot from './PlatePlot.astro';
import { profile } from '../data/profile';
---

<!-- The opening screen is laid out like a plate in a book of engravings: the picture fills the
     page, and a title block docked along the bottom says whose book it is and what the picture
     shows. Nothing sits on top of the picture. -->
<section class="hero" data-plates>
  <PlatePlot />

  <div class="wrap dock">
    <div class="block" data-quiet>
      <Image src={avatar} alt={`Portrait of ${profile.name}`} width={400} class="photo" loading="eager" fetchpriority="high" />

      <div class="cell who">
        <h1>
          <span class="name">{profile.name}</span>
          <span class="native" lang="zh">{profile.nameNative}</span>
        </h1>
        <p class="role">
          {profile.role}, <a href={profile.affiliation.url}>{profile.affiliation.name}</a>
        </p>
        <ul class="links">
          <li><a class="cv" href={profile.cv}>CV</a></li>
          {profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
        </ul>
      </div>

      <p class="cell bio" set:html={profile.bio} />

      <!-- what the picture is, the paper it is drawn after, and a way to see the others -->
      <div class="cell plate" data-plate-bar>
        <p class="label">Figure <span data-plate-count></span></p>
        <p class="caption" data-plate-caption></p>
        <!-- drawn like dimension lines on a drawing: a hairline shaft the width of its cell, a slender solid head -->
        <div class="arrows">
          <button type="button" data-plate-prev aria-label="Previous figure">
            <svg viewBox="0 0 9 7" width="9" height="7" aria-hidden="true"><path d="M0 3.5 9 0v7z" fill="currentColor" /></svg>
            <span class="shaft"></span>
          </button>
          <button type="button" data-plate-next aria-label="Next figure">
            <span class="shaft"></span>
            <svg viewBox="0 0 9 7" width="9" height="7" aria-hidden="true"><path d="M9 3.5 0 0v7z" fill="currentColor" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* the opening screen is the picture and its title block, nothing else; research starts on scroll */
    height: 100svh;
    min-height: 40rem;
    display: flex;
    align-items: flex-end;
  }
  /* `--pb` (the margin the picture keeps clear at the bottom) is set by the script from the
     title block's measured height. */
  /* The picture is pinned to the viewport: the title block and then the page slide up over it.
     Once the page has moved it fades back, so it reads as a backdrop rather than as content. */
  .hero :global(.plate-plot) {
    --pt: 92px;
    position: fixed;
    inset: 0;
    opacity: calc(1 - 0.72 * var(--scrolled, 0));
  }
  .hero :global(.plate-readout) {
    top: 64px;
  }

  .dock {
    position: relative;
    z-index: 1;
    padding-bottom: 2rem;
    pointer-events: none;
  }
  .block {
    display: grid;
    /* the photo is as wide as the section labels below, so the name lines up with the page's text column */
    grid-template-columns: calc(var(--label-col) + 2rem) minmax(22rem, 1.2fr) minmax(0, 1.5fr) minmax(14rem, 0.75fr);
    background: var(--bg-raised);
    border: 1px solid var(--ink);
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--ink) 12%, transparent);
    pointer-events: auto;
  }
  .cell {
    margin: 0;
    padding: 1.5rem 1.75rem;
    border-left: 1px solid var(--ink);
    min-width: 0;
  }
  .photo {
    width: 100%;
    height: 100%;
    min-height: 12rem;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .who {
    display: flex;
    flex-direction: column;
  }
  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.4em;
    font-size: clamp(2.75rem, 3.9vw, 3.3rem);
    font-stretch: 80%;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.92;
  }
  .native {
    font-size: 0.32em;
    font-stretch: 100%;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .role {
    font-family: var(--sans);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink-2);
    margin: 0.75rem 0 1.25rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    list-style: none;
    padding: 0;
    margin: auto 0 0;
    font-family: var(--sans);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .links a {
    text-decoration: none;
    color: var(--accent);
  }
  .links .cv {
    background: var(--mark);
    color: var(--on-mark);
    padding: 0.05em 0.5em;
  }
  .links .cv:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .bio {
    font-size: 1rem;
    line-height: 1.58;
    color: var(--ink-2);
  }

  /* a footnote to the picture: it is the smallest type on the page, so the profile reads first */
  .plate {
    display: flex;
    flex-direction: column;
    padding: 0;
    font-family: var(--sans);
    font-size: 0.71875rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .label {
    margin: 0;
    padding: 1.3rem 1.5rem 0.4rem;
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .caption {
    margin: 0;
    padding: 0 1.5rem 1.2rem;
  }
  /* The two arrows are the bottom row of the title block: one cell each, ruled like the rest. */
  .arrows {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: auto;
    border-top: 1px solid var(--ink);
  }
  .arrows button {
    display: flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 1.1rem;
    color: var(--ink);
    background: none;
    border: 0;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .arrows button + button {
    border-left: 1px solid var(--ink);
  }
  .arrows button:hover {
    background: var(--mark);
    color: var(--on-mark);
  }
  .arrows svg {
    flex: none;
  }
  .shaft {
    flex: 1;
    height: 1px;
    background: currentColor;
  }
  .caption :global(.short) {
    display: none;
  }
  .caption :global(i) {
    font-family: var(--serif);
    font-size: 1.1em;
  }
  .caption :global(a) {
    color: var(--ink-2);
  }

  /* Below this width the title block cannot sit on one line. The picture becomes a band across
     the top, with its caption under it, and the rest follows as ordinary page content. */
  @media (max-width: 1099px) {
    .hero {
      height: auto;
      min-height: 0;
      display: block;
      padding-top: 3.75rem;
      overflow: visible;
    }
    .hero :global(.plate-plot) {
      --pt: 30px;
      --pb: 14px;
      position: relative;
      inset: auto;
      height: clamp(15rem, 46vw, 24rem);
      opacity: 1;
    }
    .hero :global(.plate-readout) {
      top: 4px;
    }
    .dock {
      padding-bottom: 3.5rem;
    }
    .block {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'plate plate'
        'photo who'
        'bio bio';
      align-items: center;
      column-gap: 1.25rem;
      background: none;
      border: 0;
      box-shadow: none;
    }
    .cell {
      padding: 0;
      border: 0;
    }
    /* under the figure: its number and the arrows, then one line saying what it shows */
    .plate {
      grid-area: plate;
      flex-flow: row wrap;
      align-items: center;
      gap: 0.45rem 0.6rem;
      padding: 0.55rem 0 1.5rem;
      font-size: 0.65625rem;
    }
    .label,
    .caption {
      padding: 0;
    }
    .label {
      flex: 1;
    }
    .caption {
      order: 1;
      flex: 0 0 100%;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .caption :global(.long) {
      display: none;
    }
    .caption :global(.short) {
      display: inline;
    }
    /* the paper's own phrase, run over with the highlighter; it links to the paper */
    .caption :global(.short a) {
      background: var(--mark);
      color: var(--on-mark);
      font-weight: 500;
      text-decoration: none;
      padding: 0.05em 0.3em;
    }
    .caption :global(.short a:hover) {
      background: var(--ink);
      color: var(--bg);
    }
    .arrows {
      flex: none;
      grid-template-columns: 2.9rem 2.9rem;
      margin: 0;
      border: 1px solid var(--ink);
    }
    .arrows button {
      height: 1.75rem;
      padding: 0 0.6rem;
    }
    .photo {
      grid-area: photo;
      width: 5.5rem;
      height: 5.5rem;
      min-height: 0;
    }
    .who {
      grid-area: who;
    }
    .role {
      margin-bottom: 0.6rem;
    }
    .bio {
      grid-area: bio;
      max-width: 38rem;
      margin-top: 1.5rem;
      font-size: 1em;
    }
  }
  @media (max-width: 480px) {
    .photo {
      width: 4.25rem;
      height: 4.25rem;
      align-self: start;
    }
    h1 {
      font-size: 2.4rem;
    }
  }
</style>

<script>
  import { mountPlates } from '../scripts/plates';
  const hero = document.querySelector<HTMLElement>('[data-plates]');
  if (hero) {
    mountPlates(hero);
    // how far the page has scrolled off the opening screen, 0 to 1, for the picture's fade
    const plot = hero.querySelector<HTMLElement>('[data-plot]')!;
    const onScroll = () =>
      plot.style.setProperty('--scrolled', Math.min(1, window.scrollY / (window.innerHeight * 0.7)).toFixed(3));
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
