---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { profile } from '../data/profile';
---

<section class="hero" data-hero>
  <canvas class="field" aria-hidden="true" data-field></canvas>
  <canvas class="dots" aria-hidden="true" data-dots></canvas>
  <div class="wrap hero-inner">
    <div class="intro">
      <p class="label kicker">
        {profile.role} · <a href={profile.affiliation.url}>{profile.affiliation.name}</a>
      </p>
      <h1>
        <span class="name">{profile.name}</span>
        <span class="native" lang="zh">{profile.nameNative}</span>
      </h1>
      <div class="bio-row">
        <Image src={avatar} alt={`Portrait of ${profile.name}`} width={264} height={264} class="avatar" loading="eager" />
        <p class="bio" set:html={profile.bio} />
      </div>
      <ul class="links">
        <li><a class="cv" href={profile.cv}>Curriculum Vitae <span aria-hidden="true">↗</span></a></li>
        {profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
      </ul>
    </div>
    <p class="caption mono" aria-hidden="true">
      <span class="fig">Fig. 0</span> Noisy gradient descent on a drifting loss surface.
      <span class="hint">Move to carve a basin, click to drop a particle.</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 60rem);
    display: flex;
    align-items: flex-end;
    padding-top: 6rem;
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
    cursor: crosshair;
  }
  .field,
  .dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dots {
    -webkit-mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.55) 40%, #000 65%);
    mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.55) 40%, #000 65%);
  }
  .field {
    /* keep the lines out from under the text */
    -webkit-mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.35) 38%, #000 70%);
    mask-image: linear-gradient(100deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.35) 38%, #000 70%);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 40rem) 1fr;
    align-items: end;
    gap: 2rem;
    cursor: auto;
  }
  .intro > * {
    animation: rise 1.1s var(--ease) both;
  }
  .intro > :nth-child(2) {
    animation-delay: 0.08s;
  }
  .intro > :nth-child(3) {
    animation-delay: 0.16s;
  }
  .intro > :nth-child(4) {
    animation-delay: 0.24s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .kicker {
    margin-bottom: 1.25rem;
  }
  .kicker a {
    color: inherit;
  }
  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1em 0.4em;
    font-size: clamp(3rem, 8vw, 6.25rem);
    font-weight: 350;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: 2rem;
  }
  .native {
    font-size: 0.36em;
    letter-spacing: 0.05em;
    color: var(--muted);
    font-weight: 400;
  }
  .bio-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  .avatar {
    width: 5.5rem;
    height: 5.5rem;
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s var(--ease);
    margin-top: 0.3rem;
  }
  .bio-row:hover .avatar {
    filter: none;
  }
  .bio {
    color: var(--ink-2);
    margin: 0;
    max-width: 34rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .links a {
    text-decoration: none;
    color: var(--ink-2);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .links .cv {
    color: var(--ink);
    border-color: var(--ink);
  }
  .caption {
    justify-self: end;
    text-align: right;
    color: var(--muted);
    font-size: 0.66rem;
    max-width: 16rem;
    margin: 0;
    animation: rise 1.4s 0.5s var(--ease) both;
  }
  .caption .fig {
    color: var(--ink);
    margin-right: 0.4em;
  }
  .hint {
    display: block;
    margin-top: 0.35rem;
    color: var(--faint);
  }
  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .caption {
      justify-self: start;
      text-align: left;
    }
    .field,
    .dots {
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 45%, rgba(0, 0, 0, 0.15) 75%);
      mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.5) 45%, rgba(0, 0, 0, 0.15) 75%);
    }
    .hint {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .bio-row {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro > *,
    .caption {
      animation: none;
    }
  }
</style>

<script>
  import { mountLandscape } from '../scripts/landscape';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-field]');
  const dots = document.querySelector<HTMLCanvasElement>("[data-dots]");
  if (hero && canvas && dots) mountLandscape(canvas, dots, hero);
</script>
