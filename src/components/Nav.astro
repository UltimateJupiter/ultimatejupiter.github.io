---
import { profile } from '../data/profile';

const path = Astro.url.pathname;
const items = [
  { label: 'Publications', href: '/publications/' },
  { label: 'Talks', href: '/talks/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'News', href: '/news/' },
];
---

<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a class="brand plain" href="/" aria-label={`${profile.name}, home`}>
      <!-- the site mark: one line forking in two, as in the home page figure -->
      <svg class="fork" viewBox="0 0 26 24" width="26" height="24" aria-hidden="true">
        <path d="M1 12h9c5 0 4-7 9-7h6M10 12c5 0 4 7 9 7h6"></path>
        <circle cx="10" cy="12" r="2.8"></circle>
      </svg>
      <span>{profile.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          items.map((i) => (
            <li>
              <a class="plain" href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>
                {i.label}
              </a>
            </li>
          ))
        }
        <li><a class="plain" href={profile.cv}>CV</a></li>
        <li>
          <button class="theme" type="button" aria-label="Switch between light and dark" data-theme-toggle>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
              <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    font-family: var(--sans);
    border-bottom: 1px solid transparent;
    transition:
      background 0.25s,
      border-color 0.25s;
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--rule);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .fork path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .fork circle {
    fill: var(--mark);
    stroke: var(--ink);
    stroke-width: 1.4;
    transition: r 0.3s var(--ease);
  }
  .brand:hover .fork circle {
    r: 3.8px;
  }
  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2.4vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }
  ul a {
    text-decoration: none;
    color: var(--ink-2);
    padding: 0.1em 0.3em;
    margin: 0 -0.3em;
  }
  ul a:hover {
    color: var(--ink);
  }
  ul a[aria-current='page'] {
    background: var(--mark);
    color: var(--on-mark);
  }
  .theme {
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    padding: 4px;
    color: var(--ink-2);
    cursor: pointer;
    border-radius: 50%;
  }
  .theme:hover {
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .brand span {
      display: none;
    }
  }
  @media (max-width: 380px) {
    ul {
      gap: 0.7rem;
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (_) {}
    window.dispatchEvent(new CustomEvent('themechange'));
  });
</script>
