---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import NewsList from '../components/NewsList.astro';
import PubList from '../components/PubList.astro';
import TalkList from '../components/TalkList.astro';
import PostList from '../components/PostList.astro';
import { profile, homeLimits } from '../data/profile';
import { getNews, getPosts, getPublications, getTalks } from '../lib/content';

const pubs = await getPublications();
const news = await getNews();
const talks = await getTalks();
const posts = await getPosts();
---

<Base>
  <Hero />

  <div class="wrap over">
    <div class="sheet">
    <section class="section" aria-labelledby="about">
      <SectionHead title="Research" id="about" />
      <div class="section-body about">
        <p class="lede">{profile.research}</p>
        <dl class="facts">
          <div>
            <dt>Interests</dt>
            {profile.interests.map((i) => <dd>{i}</dd>)}
          </div>
          <div>
            <dt>Education</dt>
            {
              profile.education.map((e) => (
                <dd>
                  {e.degree}
                  <span class="edu-meta">
                    {e.institution}, {e.years}
                  </span>
                </dd>
              ))
            }
          </div>
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="news">
      <SectionHead title="News" id="news" />
      <div class="section-body">
        <NewsList items={news.slice(0, homeLimits.news)} />
        {news.length > homeLimits.news && <a class="section-more" href="/news/">All news</a>}
      </div>
    </section>

    <section class="section" aria-labelledby="papers">
      <SectionHead title="Publications" id="papers" />
      <div class="section-body">
        <PubList pubs={pubs.slice(0, homeLimits.publications)} />
        {pubs.length > homeLimits.publications && <a class="section-more" href="/publications/">All publications</a>}
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="section" aria-labelledby="blog">
          <SectionHead title="Blog" id="blog" />
          <div class="section-body">
            <PostList posts={posts.slice(0, homeLimits.posts)} />
            {posts.length > homeLimits.posts && <a class="section-more" href="/blog/">All posts</a>}
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="talks">
      <SectionHead title="Talks" id="talks" />
      <div class="section-body">
        <TalkList items={talks.slice(0, homeLimits.talks)} collapsed />
        {talks.length > homeLimits.talks && <a class="section-more" href="/talks/">All talks</a>}
      </div>
    </section>
    </div>
  </div>
</Base>

<style>
  /* Everything after the opening screen is one sheet of paper sliding up over the pinned picture,
     boxed like the title block. The picture stays visible in the margins either side. */
  .over {
    position: relative;
    z-index: 1;
  }
  .sheet {
    background: var(--bg-raised);
    border: 1px solid var(--ink);
    box-shadow: 10px 10px 0 color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .sheet > :global(.section) {
    padding-inline: 1.75rem;
  }
  .sheet > :global(.section:first-child) {
    border-top: 0;
  }
  @media (max-width: 760px) {
    .sheet {
      background: none;
      border: 0;
      box-shadow: none;
    }
    .sheet > :global(.section) {
      padding-inline: 0;
    }
    .sheet > :global(.section:first-child) {
      border-top: 1px solid var(--ink);
    }
  }
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 2rem 3.5rem;
    align-items: start;
  }
  .lede {
    font-size: 1.3em;
    line-height: 1.48;
    letter-spacing: -0.005em;
    max-width: 38rem;
    margin: 0;
  }
  .facts {
    display: grid;
    gap: 1.5rem;
    margin: 0.35rem 0 0;
    font-size: 0.93em;
    line-height: 1.4;
  }
  .facts dt {
    font-family: var(--sans);
    font-size: var(--small);
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .facts dd {
    margin: 0;
    padding: 0.2rem 0;
    color: var(--ink-2);
  }
  .edu-meta {
    display: block;
    color: var(--muted);
  }
  @media (max-width: 980px) {
    .about {
      grid-template-columns: 1fr;
    }
    .facts {
      grid-template-columns: 1fr 1.3fr;
      gap: 2rem;
      max-width: 38rem;
    }
  }
  @media (max-width: 520px) {
    .lede {
      font-size: 1.15em;
    }
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
