---
interface Props {
  title: string;
  /** A short fact about the page, shown after the title (for example "7 papers"). */
  count?: string;
}
const { title, count } = Astro.props;
---

<header class="page-header wrap">
  <h1>{title}{count && <span class="count">{count}</span>}</h1>
  <slot />
</header>

<style>
  .page-header {
    padding-top: clamp(7rem, 14vw, 10rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    font-stretch: 78%;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }
  .count {
    margin-left: 0.9rem;
    font-size: 1rem;
    font-stretch: 100%;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
    white-space: nowrap;
  }
  .page-header :global(.note) {
    margin: 1rem 0 0;
    color: var(--muted);
  }
</style>
