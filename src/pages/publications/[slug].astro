---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PlatePlot from '../../components/PlatePlot.astro';
import { plateForPaper } from '../../scripts/plates/meta';
import { authorsHtml, fmtMonth, getBibtex, getPublications, hasEqualContribution, mathHtml, type Publication } from '../../lib/content';

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs.map((pub) => ({ params: { slug: pub.id }, props: { pub } }));
}

const { pub } = Astro.props as { pub: Publication };
const { title, authors, venue, award, date, image, caption, links, abstract } = pub.data;
const bib = getBibtex(pub.id);
// papers with an illustration open with it
const plate = plateForPaper(pub.id);
---

<Base title={title} description={abstract.slice(0, 180)}>
  {
    plate && (
      <div class="plate-band" data-plates data-plate={plate.id}>
        <PlatePlot />
      </div>
    )
  }
  <article class:list={['wrap', 'paper', { 'after-plate': !!plate }]}>
    <a class="back" href="/publications/">All publications</a>
    <h1>{title}</h1>
    <p class="meta small">
      <span>{venue}, {fmtMonth(date)}</span>
      {award && <span class="marked">{award}</span>}
    </p>
    <p class="authors" set:html={authorsHtml(authors)} />
    {hasEqualContribution(authors) && <p class="small muted eq">* Equal contribution</p>}
    <div class="chips">
      {links.map((l) => <a href={l.url}>{l.name}</a>)}
    </div>

    {
      image && (
        <figure>
          <div class="frame figure-frame">
            <Image src={image} alt={caption ?? title} widths={[600, 1000, 1600]} sizes="(max-width: 900px) 92vw, 860px" />
          </div>
          {caption && (
            <figcaption class="small">{caption}</figcaption>
          )}
        </figure>
      )
    }

    {
      abstract && (
        <section>
          <h2>Abstract</h2>
          <p class="abstract" set:html={mathHtml(abstract)} />
        </section>
      )
    }

    {
      bib && (
        <section>
          <h2>Citation</h2>
          <div class="bibwrap">
            <pre><code>{bib}</code></pre>
            <button type="button" class="copy" data-copy>Copy</button>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .paper {
    max-width: calc(54rem + 2 * var(--gutter));
    padding-top: clamp(6.5rem, 12vw, 9rem);
    padding-bottom: 4rem;
  }
  .plate-band {
    padding-top: 3.75rem;
  }
  .plate-band :global(.plate-plot) {
    height: clamp(11rem, 26vw, 16rem);
    border-bottom: 1px solid var(--rule);
  }
  .paper.after-plate {
    padding-top: 2rem;
  }
  h1 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    font-stretch: 85%;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 2.25rem 0 0.9rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin: 0 0 1.5rem;
    font-weight: 500;
    color: var(--muted);
  }
  .authors {
    font-size: 1.1em;
    color: var(--ink-2);
    margin: 0;
  }
  .authors :global(.me) {
    color: var(--ink);
    font-weight: 700;
  }
  .authors :global(.eq) {
    color: var(--muted);
    font-size: 0.7em;
  }
  .eq {
    margin: 0.35rem 0 0;
  }
  .chips {
    margin-top: 1.1rem;
    font-size: 0.9375rem;
  }
  figure {
    margin: 3rem 0 0;
  }
  .frame {
    padding: clamp(0.75rem, 3vw, 2rem);
  }
  figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    max-width: 40rem;
  }
  section {
    margin-top: 3rem;
    max-width: 42rem;
  }
  section h2 {
    font-size: 1rem;
    margin-bottom: 0.8rem;
  }
  .abstract {
    color: var(--ink-2);
    hyphens: auto;
  }
  .bibwrap {
    position: relative;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
  }
  pre {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { mountPlates } from '../../scripts/plates';
  const band = document.querySelector<HTMLElement>('[data-plates]');
  if (band) mountPlates(band);
</script>

<script>
  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(btn.parentElement?.querySelector('code')?.textContent ?? '');
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Select and copy';
    }
    setTimeout(() => (btn.textContent = 'Copy'), 1600);
  });
</script>
